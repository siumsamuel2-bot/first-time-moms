{
  "name": "@firstweeks/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/main.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc && tsc-alias",
    "build:lambda": "tsc -p tsconfig.lambda.json && tsc-alias -p tsconfig.lambda.json",
    "start": "node dist/main.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:clinicians": "tsx scripts/seed-clinicians.ts",
    "db:seed:test-moms": "tsx scripts/seed-test-moms.ts",
    "db:seed:providers": "tsx scripts/seed-providers.ts",
    "db:seed:e2e": "tsx scripts/seed-e2e.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/client-secrets-manager": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@fastify/cookie": "11.0.1",
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "12.0.0",
    "@fastify/jwt": "10.2.4",
    "@fastify/rate-limit": "10.0.1",
    "@fastify/sensible": "6.0.3",
    "@fastify/swagger": "9.2.0",
    "@fastify/swagger-ui": "6.1.2",
    "@fastify/type-provider-typebox": "5.0.0",
    "@firstweeks/shared": "workspace:*",
    "@prisma/client": "5.22.0",
    "@sinclair/typebox": "0.33.13",
    "argon2": "0.41.1",
    "fastify": "5.12.5",
    "pino": "9.5.0",
    "pino-pretty": "13.0.0",
    "web-push": "^3.6.7",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "20.17.0",
    "@types/web-push": "^3.6.4",
    "prisma": "5.22.0",
    "tsc-alias": "1.8.10",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "3.0.9"
  }
}
