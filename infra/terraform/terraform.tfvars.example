# Copy to terraform.tfvars and fill in real values. Never commit terraform.tfvars.
#
# Availability domains can be listed with:
#   oci iam availability-domain list --all

compartment_ocid      = "ocid1.compartment.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxx"
availability_domain   = "xxxx:US-ASHBURN-AD-1"
environment           = "staging"

# Always Free limits: 4 OCPUs / 24 GB total across A1.Flex instances
app_instance_count    = 2
app_instance_ocpu     = 2
app_instance_memory_gb = 12
boot_volume_size_gb   = 50

ssh_public_key        = "ssh-rsa AAAA... your-key@host"

db_admin_password     = "CHANGE_ME_Str0ngPassw0rd!"
db_name               = "firstweeksdb"
db_display_name       = "firstweeks-staging-db"

asset_bucket_name     = "firstweeks-staging-assets"
app_container_image   = "docker.io/library/nginx:alpine"
app_port              = 8080
