{
  "name": "firstweeks",
  "version": "0.0.0",
  "private": true,
  "description": "Firstweeks postpartum support app - monorepo",
  "scripts": {
    "dev": "pnpm --filter=@firstweeks/api --filter=@firstweeks/web dev",
    "build": "pnpm --filter=@firstweeks/api --filter=@firstweeks/web build",
    "lint": "pnpm --filter=@firstweeks/api --filter=@firstweeks/web --filter=@firstweeks/shared lint",
    "typecheck": "pnpm --filter=@firstweeks/api --filter=@firstweeks/web --filter=@firstweeks/shared typecheck",
    "test": "pnpm --filter=@firstweeks/api --filter=@firstweeks/web --filter=@firstweeks/shared test",
    "test:unit": "pnpm --filter=@firstweeks/api --filter=@firstweeks/web --filter=@firstweeks/shared test:unit",
    "test:e2e": "pnpm --filter=@firstweeks/web test:e2e",
    "db:generate": "pnpm --filter=@firstweeks/api db:generate",
    "db:push": "pnpm --filter=@firstweeks/api db:push",
    "db:migrate": "pnpm --filter=@firstweeks/api db:migrate",
    "db:studio": "pnpm --filter=@firstweeks/api db:studio",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "postpartum",
    "healthcare",
    "pwa"
  ],
  "author": "Firstweeks Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@prisma/client": "5.22.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "20.17.0",
    "jsdom": "^30.1.2",
    "prisma": "5.22.0",
    "typescript": "5.7.2",
    "vitest": "3.0.9"
  },
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=20.0.0"
  }
}